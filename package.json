{
  "name": "mcp-suite-mx",
  "mcpName": "io.github.donovan-hue/mcp-suite-mx",
  "version": "0.2.0",
  "description": "Plataforma MCP para empresas mexicanas: multi-empresa, negocio con IVA/retenciones, CFDI 4.0, documentos, análisis, DevOps, taller, centinela, parche, orquesta y rúter. stdio (local) y HTTP (remoto).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-suite-mx": "dist/index.js",
    "mcp-suite-mx-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "cli": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donovan-hue/donovan-hue.git"
  },
  "homepage": "https://github.com/donovan-hue/donovan-hue#readme",
  "bugs": {
    "url": "https://github.com/donovan-hue/donovan-hue/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cfdi",
    "mexico",
    "sqlite",
    "agents",
    "security",
    "code-repair"
  ],
  "files": [
    "dist",
    "paginas",
    "!paginas/hero-fucsia.png",
    "docs",
    "LICENSE",
    "README.md",
    ".env.example"
  ]
}
