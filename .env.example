# ── Transporte ────────────────────────────────────────────────────────────────
# stdio = local (Claude Desktop, Cursor, Claude Code) | http = remoto
MCP_TRANSPORT=http
PORT=8787
HOST=0.0.0.0

# ── Rutas de datos ────────────────────────────────────────────────────────────
# Directorio base: SQLite (suite.db), datasets, plantillas y auditoría.
DATA_DIR=./data

# ── Seguridad (fase 2) ────────────────────────────────────────────────────────
# off      = sin autenticación (solo desarrollo; se rechaza con NODE_ENV=production)
# optional = valida la clave si viene, pero permite llamadas sin ella
# required = obliga a usar Authorization: Bearer <api key>  ← recomendado en HTTP
AUTH_MODE=required

# Claves de arranque (bootstrap) separadas por coma, para CI o despliegues
# desechables. Para uso humano crea claves con: node dist/cli.js keys create
# MCP_API_KEYS=

# Límite de tasa por cliente autenticado (herramientas por minuto) y ráfaga.
# 0 desactiva el limitador.
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30

# Confiar en X-Forwarded-For para identificar al cliente (solo detrás de un
# reverse proxy propio que reescriba la cabecera).
TRUST_PROXY=0

# ── TLS / HTTPS (producción) ──────────────────────────────────────────────────
# Rutas al certificado y la llave en PEM. Ambos o ninguno: con los dos, el
# transporte http arranca en HTTPS con HSTS.
# Para pruebas: node scripts/certificado-autofirmado.mjs
# TLS_CERT=./data/tls/cert.pem
# TLS_KEY=./data/tls/key.pem

# ── Facturación (CFDI 4.0) ────────────────────────────────────────────────────
# Datos fiscales del emisor; si los defines, las herramientas de facturación no
# piden el bloque "emisor" en cada llamada.
# CFDI_EMISOR_RFC=DJA240118H72
# CFDI_EMISOR_NOMBRE=Distribuidora Jalisco SA de CV
# CFDI_EMISOR_REGIMEN=601
# CFDI_EMISOR_CP=44100

# ── Reglas de negocio (México) ────────────────────────────────────────────────
IVA_PCT=16

# Rutas donde las herramientas de git pueden operar (separadas por coma).
# Ejemplo: /home/sistemas/repos,/var/www
ALLOWED_GIT_ROOTS=

# Permitir http_health_check contra IPs privadas/red local (1/0)
HTTP_CHECK_ALLOW_PRIVATE=0

# Orígenes permitidos para CORS en modo HTTP (* = cualquiera, dev)
CORS_ORIGIN=*

# ── Logs ──────────────────────────────────────────────────────────────────────
# debug | info | warn | error   (siempre a stderr, nunca a stdout)
LOG_LEVEL=info

# ── Parche (reparar con red de seguridad, fase 4C) ────────────────────────────
# Límite de pruebas por parche (evita bucles que no llevan a nada).
# PARCHE_MAX_INTENTOS=3
# Tiempo máximo de cada corrida de pruebas, en milisegundos.
# PARCHE_PRUEBA_TIMEOUT_MS=120000

# ── Centinela (seguridad, fase 4B) ────────────────────────────────────────────
# Vigencia de una aprobación humana en minutos (una aprobación vencida deja de
# autorizar y pasa a estado "expirada"). 0 = sin vencimiento.
# APROBACION_VIGENCIA_MIN=120

# Mapa vivo del Taller (/taller y /api/taller/mapa).
# 1 = público (cómodo en local) · 0 = exige API key cuando AUTH_MODE=required.
# TALLER_PUBLICO=1

# ── Multi-empresa (fase 5A) ───────────────────────────────────────────────────
# Empresa activa al arrancar (id EMP-xxxxxx o nombre). Las claves de API atadas
# a una empresa (keys create --empresa) tienen prioridad sobre esta variable.
EMPRESA_DEFAULT=
